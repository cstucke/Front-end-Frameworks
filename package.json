{
  "name": "cinegrid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "type-check": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:run:verbose": "vitest run --reporter=verbose",
    "test:m1": "vitest run src/test/milestone-01.test.tsx",
    "test:m2": "vitest run src/test/milestone-02.test.tsx",
    "test:m3": "vitest run src/test/milestone-03.test.tsx",
    "test:features": "vitest run src/test/features.test.tsx src/test/tmdb-api.test.ts"
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "media-chrome": "^4.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
